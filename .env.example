# Copy to .env and fill in real values. Never commit .env.
#
# All of these are read by the server only (server.js / keepa.js). None of them
# are exposed to the browser — do not add a REACT_APP_ prefix to any of them, as
# that would bake the value into the public JavaScript bundle.

# Keepa product API key — https://keepa.com/#!api
KEEPA_API_KEY=

# Discord incoming webhook URL for lead alerts
DISCORD_WEBHOOK=

# Tactical Arbitrage login, used by the twice-daily auto-scan
TA_EMAIL=
TA_PASSWORD=

# Port for the Express server (defaults to 4000)
PORT=4000
